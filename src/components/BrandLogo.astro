---
import { Image } from 'astro:assets';
import zomato from '../assets/brand/zomato.png';
import bosch from '../assets/brand/bosch.png';
import loreal from '../assets/brand/loreal.png';
import vega from '../assets/brand/vega.png';
import dell from '../assets/brand/dell.png';

// Official logo files exported from the Figma board. They are recoloured to solid black in CSS (as in the design).
const { name } = Astro.props as { name: string };
const logos: Record<string, { src: ImageMetadata; alt: string }> = {
  zomato: { src: zomato, alt: 'Zomato' },
  bosch: { src: bosch, alt: 'Bosch' },
  loreal: { src: loreal, alt: "L'Oréal" },
  vega: { src: vega, alt: 'Vega' },
  dell: { src: dell, alt: 'Dell' },
};
const logo = logos[name];
---
{logo && (
  <span class={`logo logo--${name}`}>
    <Image src={logo.src} alt={logo.alt} widths={[240, 480]} sizes="(max-width: 700px) 30vw, 11vw" format="webp" quality={85} loading="lazy" decoding="async" />
  </span>
)}
