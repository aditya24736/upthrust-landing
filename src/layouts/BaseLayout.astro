---
import '../styles/global.css';
import site from '../content/site.json';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: object[];
}
const { title = site.title, description = site.description, noindex = false, jsonLd = [] } = Astro.props;

const origin = (Astro.site ?? new URL('https://upthrust-landing.netlify.app')).toString().replace(/\/$/, '');
const canonical = origin + Astro.url.pathname;
const ogImage = `${origin}/images/og-image.jpg`;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.ogTitle} />
    <meta property="og:description" content={site.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Upthrust Design — iridescent bust sculpture on a white background" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.ogTitle} />
    <meta name="twitter:description" content={site.ogDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts are self-hosted, subset and preloaded (no third-party font requests). -->
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/anton-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- GTM data layer exists from the first byte so events are never lost. GTM itself loads after `load`. -->
    <script is:inline define:vars={{ gtmId }}>
      window.dataLayer = window.dataLayer || [];
      if (gtmId) {
        window.addEventListener('load', function () {
          var start = function () {
            window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
            document.head.appendChild(s);
          };
          'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 3000 }) : setTimeout(start, 2000);
        });
      }
    </script>

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
