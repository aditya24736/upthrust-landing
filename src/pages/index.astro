---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandLogo from '../components/BrandLogo.astro';
import site from '../content/site.json';
import home from '../content/home.json';
import statue from '../assets/hero/statue.png';
import curve from '../assets/hero/curve.webp';
import hlTop from '../assets/hero/hl-top.webp';
import hlThat from '../assets/hero/hl-that.webp';
import hlBot from '../assets/hero/hl-bot.webp';
import blueprint from '../assets/hero/blueprint.webp';
import marks from '../assets/hero/marks.webp';
import rocket from '../assets/brand/rocket.png';
import mark from '../assets/brand/mark.png';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const { hero, proof } = home;
const f = site.footer;
const origin = (Astro.site ?? new URL('https://upthrust-landing.netlify.app')).toString().replace(/\/$/, '');

// Structured data is generated from the same content the page renders, so CMS edits stay in sync.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: origin + '/',
    logo: origin + '/favicon.svg',
    description: site.description,
    email: f.columns[0].email,
    sameAs: [...f.sites.map((s) => s.url), ...f.social.map((s) => s.url)],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: origin + '/',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Upthrust services',
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: { '@type': 'Service', name: s.data.title, description: s.data.intro, provider: { '@type': 'Organization', name: site.name } },
    })),
  },
];
---
<BaseLayout {jsonLd}>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Upthrust — home">
      <Image src={rocket} alt="" width={31} height={30} densities={[1, 2]} loading="eager" />
      <span>Upthrust</span>
    </a>
    <a class="header-cta" href={site.headerCta.href}>{site.headerCta.label}</a>
    <details class="menu">
      <summary aria-label="Open menu"><span class="menu__bars" aria-hidden="true"><i></i><i></i><i></i></span></summary>
      <nav class="menu__panel" aria-label="Main">
        <ul>
          {site.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
    </details>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <div class="stage">
        <Image class="bp" src={blueprint} alt="" widths={[480, 960]} sizes="(max-width: 700px) 70vw, 42vw" format="webp" quality={72} loading="eager" decoding="async" layout="fixed" width={960} />
        <h1 id="hero-title" class="sr-only">{hero.lineTop} {hero.lineMiddle} {hero.lineBottom}</h1>
        <!-- The warped lettering is the exact vector artwork from Figma (CSS cannot reproduce an envelope warp). The real H1 text above stays in the HTML for SEO and screen readers. -->
        <Image class="hl hl--top" src={hlTop} alt="" widths={[720, 1440, 2160]} sizes="95vw" format="webp" quality={95} loading="eager" fetchpriority="high" layout="fixed" width={1363} />
        <Image class="hl hl--that" src={hlThat} alt="" widths={[300, 600]} sizes="21vw" format="webp" quality={95} loading="eager" layout="fixed" width={297} />
        <Image class="hl hl--bot" src={hlBot} alt="" widths={[720, 1440, 2160]} sizes="79vw" format="webp" quality={95} loading="eager" fetchpriority="high" layout="fixed" width={1130} />

        <Image
          class="statue"
          src={statue}
          alt={hero.statueAlt}
          widths={[480, 760, 1100]}
          sizes="(max-width: 700px) 56vw, 37vw"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
          layout="fixed"
          width={760}
        />
        <Image class="marks__art" src={marks} alt="" widths={[720, 1440, 2160]} sizes="100vw" format="webp" quality={95} loading="eager" layout="fixed" width={1440} />

        <p class="tag tag--strategy">Strategy is<br /><span class="mark-circle">cheaper
          <svg class="mk" aria-hidden="true" viewBox="0 0 96 40" preserveAspectRatio="none"><path d="M14 9C34-2 86 0 92 17 97 33 46 39 17 31 -3 25 1 9 34 5" fill="none" stroke="#ff4a0a" stroke-width="2.2" stroke-linecap="round"/></svg>
        </span></p>

        <p class="tag tag--comfort">Comfortable<br />is expensive
          <svg class="wave mk" aria-hidden="true" viewBox="0 0 150 8" preserveAspectRatio="none"><path d="M1 4q4.500-4.500 9 0t9 0 9 0 9 0 9 0 9 0 9 0 9 0 9 0 9 0 9 0 9 0 9 0 9 0 9 0 9 0" fill="none" stroke="#ff4a0a" stroke-width="1.600" stroke-linecap="round"/></svg>
        </p>

        <ul class="tag tag--disciplines" aria-label="Disciplines">
          {hero.disciplines.map((d, i) => (
            <li>{i === hero.disciplines.length - 1 ? <span class="brush">{d}<svg class="mk" aria-hidden="true" viewBox="0 0 100 8" preserveAspectRatio="none"><path d="M1 6C25 2 60 1 99 3 60 3 30 5 6 7" fill="none" stroke="#ff4a0a" stroke-width="1.800" stroke-linecap="round"/></svg></span> : d}<span aria-hidden="true"> ·</span></li>
          ))}
        </ul>
      </div>

      <div class="proof">
        <p class="proof__count"><strong>{proof.count}</strong><span>{proof.caption}</span></p>
        <ul class="proof__logos" aria-label="Brands we have worked with">
          {proof.brands.map((b) => <li><BrandLogo name={b} /></li>)}
        </ul>
      </div>
    </section>

    <section id="services" class="services" aria-label="Our services" data-services>
      <div class="services__sticky">
        <div class="services__scroller" tabindex="0" role="region" aria-label="Services, scroll sideways to browse">
          <div class="services__track">
            <Image class="services__curve services__curve--a" src={curve} alt="" widths={[1600, 2800, 4320]} sizes="300vw" format="webp" quality={78} loading="lazy" decoding="async" layout="fixed" width={4320} />
            <Image class="services__curve services__curve--b" src={curve} alt="" widths={[1600, 2800, 4020]} sizes="280vw" format="webp" quality={78} loading="lazy" decoding="async" layout="fixed" width={4020} />
            {services.map((s, i) => (
              <article class="slide" aria-labelledby={`svc-${i}`}>
                <p class="slide__eyebrow">{home.services.eyebrow}</p>
                <h2 id={`svc-${i}`} class="slide__title">{s.data.title}</h2>
                <div class="slide__body">
                  <Image class="slide__img" src={s.data.image} alt={s.data.imageAlt} widths={[480, 760, 984]} sizes="(max-width: 700px) 80vw, (max-width: 1023px) 45vw, 34vw" format="webp" quality={80} loading="lazy" decoding="async" layout="fixed" width={984} />
                  <div class="slide__copy">
                    <p class="slide__intro">{s.data.intro}</p>
                    <ul class="slide__list">
                      {s.data.bullets.map((b) => <li>{b}</li>)}
                    </ul>
                    {s.data.note && <p class="slide__note">{s.data.note}</p>}
                    <a class="btn" href="#contact">{home.services.cta}</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer id="contact" class="footer">
    <p class="footer__word" aria-hidden="true">
      <span>UPTHRUST</span><Image class="footer__mark" src={mark} alt="" width={120} height={111} loading="lazy" /><span>DESIGN</span>
    </p>
    <div class="footer__grid">
      <div class="footer__left">
        {f.columns.map((c) => (
          <div class="footer__col">
            <a class="ext" href={c.linkUrl} rel="noopener">{c.linkLabel}<svg aria-hidden="true" viewBox="0 0 12 12" width="11" height="11"><path d="M2 10 10 2M4 2h6v6" fill="none" stroke="currentColor" stroke-width="1.400"/></svg></a>
            <p class="footer__desc">{c.text}<br /><a class="muted" href={`mailto:${c.email}`}>{c.email}</a></p>
          </div>
        ))}
        <p class="footer__tagline muted">{f.tagline}</p>
      </div>

      <div class="footer__right">
        <form class="news" name="newsletter" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field" novalidate data-news>
          <input type="hidden" name="form-name" value="newsletter" />
          <p class="hp" aria-hidden="true"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <div data-news-fields>
            <h2 class="news__title">{f.newsletter.heading}</h2>
            <div class="news__consent">
              <input id="consent" name="consent" type="checkbox" required aria-describedby="consent-err" />
              <label for="consent">{f.newsletter.consent}</label>
            </div>
            <p class="news__err" id="consent-err" data-err-consent hidden>Please tick the box to subscribe.</p>
            <label class="sr-only" for="email">Email address</label>
            <input class="news__email" id="email" name="email" type="email" required autocomplete="email" placeholder={f.newsletter.placeholder} aria-describedby="email-err" />
            <p class="news__err" id="email-err" data-err-email hidden>Please enter a valid email address.</p>
            <button class="news__submit" type="submit">{f.newsletter.button}</button>
            <p class="news__err" data-err-server hidden role="alert">Something went wrong. Please try again in a moment.</p>
          </div>
          <p class="news__success" data-news-success tabindex="-1" role="status" hidden>{f.newsletter.success}</p>
        </form>

        <div class="footer__links">
          <p>{f.sites.map((s, i) => <><a class="ext" href={s.url} rel="noopener">{s.label}<svg aria-hidden="true" viewBox="0 0 12 12" width="11" height="11"><path d="M2 10 10 2M4 2h6v6" fill="none" stroke="currentColor" stroke-width="1.400"/></svg></a>{i < f.sites.length - 1 ? ' ' : ''}</>)}</p>
          <p>{f.social.map((s, i) => <><a href={s.url} rel="noopener">{s.label}</a>{i < f.social.length - 1 ? ', ' : ''}</>)}</p>
          <p class="muted"><a class="muted" href={f.privacyUrl}>{f.privacyLabel}</a><br />{f.copyright}</p>
        </div>
      </div>
    </div>
  </footer>

  <script>
    import '../scripts/services';
    import '../scripts/newsletter';
  </script>
</BaseLayout>
