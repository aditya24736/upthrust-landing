# Copy to .env for local work. NEVER commit .env (it is git-ignored).
# Canonical origin of the deployed site (no trailing slash). Used for canonical URL, OG tags, sitemap.
PUBLIC_SITE_URL=https://YOUR-SITE.netlify.app
# Google Tag Manager container ID (public by design, but kept in env so each environment can differ).
PUBLIC_GTM_ID=GTM-XXXXXXX
